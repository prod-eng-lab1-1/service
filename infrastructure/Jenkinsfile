pipeline {
    agent any

    tools {
        jdk 'jdk21'
        gradle 'gradle-8'
    }

    environment {
        DOCKER_HUB_USERNAME = 'calinfrunzeanu'
        DOCKER_PASSWORD = credentials('docker_password')
        GITHUB_TOKEN = credentials('github_token')
    }

    stages {
        stage('Build') {
            steps {
                sh './gradlew clean build'
            }
        }

        stage('Test') {
            steps {
                sh './gradlew test'
            }
        }

        stage('Version & Tag') {
            steps {
                script {
                    sh 'git fetch --tags'
                    env.MAJOR_VERSION = sh(
                        script: 'git tag | sort -V | tail -1 | cut -d . -f 1',
                        returnStdout: true
                    ).trim()
                    env.MINOR_VERSION = sh(
                        script: 'git tag | sort -V | tail -1 | cut -d . -f 2',
                        returnStdout: true
                    ).trim()
                    env.PATCH_VERSION = sh(
                        script: 'git tag | sort -V | tail -1 | cut -d . -f 3',
                        returnStdout: true
                    ).trim()
                    
                    // Tratăm cazul în care nu există încă niciun tag (ex: prima rulare)
                    if (!env.MAJOR_VERSION || env.MAJOR_VERSION == "") {
                        env.MAJOR_VERSION = "1"
                        env.MINOR_VERSION = "0"
                        env.PATCH_VERSION = "0"
                    }
                    
                    def minorInt = env.MINOR_VERSION.toInteger()
                    env.IMAGE_TAG = "${env.MAJOR_VERSION}.${minorInt + 1}.${env.PATCH_VERSION}"
                    echo "Building version: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $DOCKER_HUB_USERNAME/prod-eng-img:$IMAGE_TAG -f ./Dockerfile .'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh '''
                    echo $DOCKER_PASSWORD_PSW | docker login -u $DOCKER_HUB_USERNAME --password-stdin
                    docker push $DOCKER_HUB_USERNAME/prod-eng-img:$IMAGE_TAG
                '''
            }
        }

        stage('Tag Release') {
            steps {
                sh '''
                    git tag $IMAGE_TAG
                    git push https://$GITHUB_TOKEN_USR:$GITHUB_TOKEN_PSW@github.com/prod-eng-lab1-1/service.git $IMAGE_TAG
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout'
        }
    }
}